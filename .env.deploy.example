# Settings for `bin/kamal`, read by config/deploy.yml.
# cp .env.deploy.example .env.deploy (gitignored) and fill in.

# The server's IP or hostname (SSH access, Docker installed by `kamal setup`).
DEMO_SERVER=203.0.113.7

# The public hostname: a DNS record pointing at the server; gets a Let's
# Encrypt certificate and becomes the only host the app answers to.
DEMO_HOST=rori.example.com

# Run Solid Queue (the nightly reset, server-side commands' jobs) inside Puma;
# false if jobs run elsewhere (e.g. a `job` role running bin/jobs).
SOLID_QUEUE_IN_PUMA=true
