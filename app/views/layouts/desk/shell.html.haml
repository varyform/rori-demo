-# The desk shell: full page loads render the requested page as the first
-# window. Apps add to <head> with `content_for :head`.
!!!
%html{ lang: I18n.locale, data: { theme: current_theme&.slug } }
  %head
    %title= windowed? ? window_title : t("app_name")
    %meta{ name: "viewport", content: "width=device-width,initial-scale=1" }
    %meta{ name: "apple-mobile-web-app-capable", content: "yes" }
    %meta{ name: "application-name", content: t("app_name") }
    %meta{ name: "mobile-web-app-capable", content: "yes" }
    -# Turbo's hover-prefetch cache is keyed by URL alone and hands its response
    -# to the next fetch of that URL, whatever frame asks. Window frames have
    -# generated ids, so a page prefetched for `_top` or another window arrives
    -# without the requesting frame and the window shows "missing frame".
    %meta{ name: "turbo-prefetch", content: "false" }
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    %link{ rel: "icon", href: "/icon.png", type: "image/png" }
    %link{ rel: "icon", href: "/icon.svg", type: "image/svg+xml" }
    %link{ rel: "apple-touch-icon", href: "/icon.png" }
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags

  %body{ class: desk_wallpaper_classes,
    style: ("--desk-wallpaper: #{desk_wallpaper.css_image}" if desk_wallpaper),
    data: { controller: "desk desk-palette desk-theme desk-wallpaper desk-terminal",
    desk_theme_cookie_value: Desk.theme_cookie,
    desk_wallpaper_cookie_value: Desk.wallpaper_cookie,
    desk_wallpaper_mode_value: desk_wallpaper_mode,
    desk_terminal_root_value: desk_commands_path,
    desk_terminal_key_value: Desk.terminal_key,
    desk_terminal_prompt_value: t("desk.terminal.prompt"),
    desk_terminal_messages_value: t("desk.terminal.messages").to_json,
    desk_palette_root_value: desk_commands_path,
    desk_root_url_value: root_path,
    desk_load_error_value: t("desk.window.load_error"),
    desk_workspace_group_value: t("desk.commands.workspaces.group"),
    desk_new_workspace_label_value: t("desk.commands.workspaces.new"),
    desk_keymap_value: Desk.resolved_keymap(desk_modifier).to_json,
    desk_native_value: desk_native?.to_s,
    desk_hover_keymap_value: Desk.resolved_hover_keymap.to_json,
    desk_hover_timeout_value: (Desk.hover_timeout * 1000).round,
    desk_discard_prompt_value: t("desk.window.discard"),
    action: ["keydown@window->desk#keydown",
      "keydown@window->desk-palette#keydown",
      "resize@window->desk#layout",
      "pagehide@window->desk#save",
      "message->desk#streamMessage:capture",
      "turbo:before-stream-render@document->desk#streamRender",
      "turbo:before-visit@document->desk#interceptVisit",
      "keydown@window->desk-terminal#keydown",
      "desk-command:run->desk#command",
      "desk-command:source->desk#commandSource",
      "desk-command:run->desk-theme#run",
      "desk-command:preview->desk-theme#preview",
      "desk-command:closed->desk-theme#revert",
      "desk-command:run->desk-wallpaper#run",
      "desk-command:preview->desk-wallpaper#preview",
      "desk-command:closed->desk-wallpaper#revert",
      "desk:toggle-terminal->desk-terminal#toggle",
      "desk:open-palette->desk-palette#open"].join(" ") } }
    = render "desk/menubar"
    %main.viewport{ data: { desk_target: "viewport", action: "wheel->desk#wheel:!passive pointermove->desk#hover pointerleave->desk#unhover" } }
      = render "desk/wallpaper"
      .stack{ data: { desk_target: "stack" } }
      -# Windows wait here until their page says where they go; modals stay here.
      .floating{ data: { desk_target: "floating" } }
        - if windowed?
          = render "desk/window", frame_id: "win_main", src: (request.fullpath if request.get?), body: safe_join([yield, window_meta_tag])
        - else
          = yield
      -# Tags the window whose field has focus (desk/typing_badge.css, anchor positioning).
      %span.typing-badge.typing-badge--side{ "aria-hidden": "true" }= t("desk.window.typing")
      %span.typing-badge.typing-badge--inside{ "aria-hidden": "true" }= t("desk.window.typing")
    = render "desk/statusbar"
    = render "desk/terminal"
    = render "desk/palette"
    %template{ data: { desk_target: "template" } }
      = render "desk/window"
