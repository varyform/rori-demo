-# locals: (frame_id: nil, src: nil, body: nil)
-# Rendered once server-side for the page being loaded, and once inside a
-# <template> the desk clones for every window it opens.
%dialog.win{ open: body.present?, tabindex: -1, data: { desk_target: "window",
  action: "pointerdown->desk#focusWindow focusin->desk#focusWindow input->desk#markDirty change->desk#markDirty cancel->desk#cancel" } }
  %header.win__bar{ data: { action: "dblclick->desk#toggleFullWidth" } }
    %button.win__btn{ type: "button", title: t(".back"), disabled: true, data: { action: "desk#back", window_part: "back" } } ←
    %span.win__title{ data: { window_part: "title" } }
    %button.win__btn{ type: "button", title: t(".detach"), data: { action: "desk#detach" } } ↗
    %button.win__btn{ type: "button", title: t(".close"), data: { action: "desk#close" } } ×
  .win__body
    = turbo_frame_tag frame_id, src: src, complete: src.present?, refresh: "morph",
      data: { action: "turbo:frame-load->desk#frameLoaded turbo:frame-missing->desk#frameMissing" } do
      = body
