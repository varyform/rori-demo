-# locals: (command:)
- shortcut = desk_shortcut(command.action)
%li.palette__item{ role: "option",
  data: { desk_palette_target: "item", url: command.url, desk_action: command.action, param: command.param,
    children: command.children, source: command.source, shortcut: shortcut,
    current: command.current || nil, search: "#{command.label} #{command.group}",
    action: "click->desk-palette#pick mousemove->desk-palette#hover" } }
  %span.palette__label
    = command.label
    - if command.children || command.source
      %span.palette__more ›
  - if shortcut
    %kbd.palette__shortcut= shortcut
  %span.palette__group
    - if command.current
      %span.palette__check ✓
    = command.group
