%dialog.palette{ "aria-label": t(".label"), data: { palette_target: "dialog", action: "click->palette#backdrop" } }
  %input.palette__input{ type: "search", placeholder: t(".placeholder"), autocomplete: "off", spellcheck: "false",
    data: { palette_target: "input", action: "input->palette#filter keydown->palette#navigate" } }
  = turbo_frame_tag "commands", src: commands_path, loading: :lazy, class: "palette__results",
    data: { palette_target: "frame", action: "turbo:frame-load->palette#filter" }
  %p.palette__empty{ hidden: true, data: { palette_target: "empty" } }= t(".empty")
  %footer.palette__hint= t(".hint_html")
